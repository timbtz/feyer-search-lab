[Unit]
Description=Feyer native GitHub proposer broker (one agent, AMD evaluation)
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/developer/feyer-agents/control
Environment=PATH=/home/developer/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -u -m lab.host_broker --config /home/developer/feyer-agents/broker.json
Restart=on-failure
RestartSec=15
KillMode=control-group
TimeoutStopSec=20
MemoryHigh=1200M
MemoryMax=1536M
MemorySwapMax=0
CPUQuota=100%
TasksMax=256
Nice=10
UMask=0077

[Install]
WantedBy=default.target
